<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Asked for at run time on Android 13 and later (the push plugin asks). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The service that keeps a call alive. A ringing call is of the type
         phoneCall, which Android 14 grants to an app that manages its own
         calls (MANAGE_OWN_CALLS, given at install; no Telecom connection
         service is registered). The microphone and the camera join when the
         call goes on. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <!-- The ringing call over the lock screen. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- The proximity sensor at the ear, the processor awake during a call. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The call's sound mode and route. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Bluetooth headsets by name (Android 12 and later ask at run time). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <application>
        <service
            android:name="net.veydan.call.CallService"
            android:exported="false"
            android:foregroundServiceType="phoneCall|microphone|camera" />

        <receiver
            android:name="net.veydan.call.CallActionReceiver"
            android:exported="false" />

        <!-- Its own task, out of the recent apps: it is never the app's
             window, and the app's window never shows over the lock screen. -->
        <activity
            android:name="net.veydan.call.IncomingCallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity="net.veydan.call.incoming"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
    </application>
</manifest>
