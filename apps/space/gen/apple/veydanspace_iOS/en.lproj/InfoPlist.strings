"NSMicrophoneUsageDescription" = "Record voice messages and audio notes, and make calls";
"NSPhotoLibraryUsageDescription" = "Attach photos and videos from your library";
"NSPhotoLibraryAddUsageDescription" = "Save received photos and videos to your library";
