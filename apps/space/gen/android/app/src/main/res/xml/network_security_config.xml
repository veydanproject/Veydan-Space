<!-- No plain HTTP, except to the app's own server of the messenger on the
     loopback: videos and pictures of messages play from there
     (crates/messenger-app/src/media_server.rs). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
